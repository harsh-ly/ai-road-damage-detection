# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# ============================================================

# Gemini AI key — obtain from Google AI Studio
GEMINI_API_KEY=

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin invite code — share only with trusted civic authorities
ADMIN_CODE=

# Email notification settings
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# Database — leave DATABASE_URL blank to use local SQLite
DATABASE_URL=

# Optional: explicit MySQL connection params (used only when DATABASE_URL is blank)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# CORS — comma-separated list of allowed frontend origins (e.g. https://yourdomain.com,http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

